{
  "name": "huqan",
  "version": "0.12.0",
  "description": "Local-first AI governance and verification layer for claims, agent actions, memory writes, provenance, approvals, and Trust Receipts.",
  "main": "index.js",
  "types": "index.d.ts",
  "bin": {
    "huqan": "./cli.js",
    "huqan-mcp": "./bin/huqan-mcp.js",
    "huqan-gate": "./bin/huqan-gate-hook.js"
  },
  "scripts": {
    "prepublishOnly": "npm run check:package-closure",
    "start": "node cli.js",
    "server": "node server.js",
    "server:guarded": "node scripts/huqan-watchdog.js",
    "mcp": "node mcpServer.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "pilot:trust-receipt": "node scripts/run-trust-receipt-pilot.js",
    "bench": "node benchmarks/bench.js",
    "bench:observability": "node benchmarks/observability-agent-v3-baseline.js",
    "bench:observability:load": "node benchmarks/observability-load-smoke.js",
    "bench:observability:soak": "node --expose-gc benchmarks/observability-soak.js",
    "lint": "oxlint",
    "verify": "node scripts/verify-suite.js",
    "check:action-pins": "node scripts/check-action-pins.js",
    "check:licenses": "node scripts/check-licenses.js",
    "check:control-chars": "node scripts/check-control-chars.js",
    "arch:snapshot": "node scripts/architecture-snapshot.js",
    "check:architecture-trackers": "node scripts/architecture-snapshot.js --check",
    "check:cycles": "node scripts/check-import-cycles.js",
    "check:module-boundary": "node scripts/check-module-boundary.js",
    "check:layers": "node scripts/check-layers.js",
    "check:doc-status": "node scripts/check-doc-status.js",
    "check:docs-drift": "node scripts/check-docs-drift.js",
    "check:file-size": "node scripts/check-file-size.js",
    "check:dead-code": "node scripts/check-dead-code.js",
    "check:package-closure": "node scripts/check-package-closure.js",
    "check:benign-false-block-rate": "node scripts/benign-false-block-rate.js",
    "check:enforcement-coverage": "node scripts/enforcement-coverage.js",
    "check:capability-usage": "node scripts/capability-usage.js",
    "verify:tarball": "node scripts/verify-package-tarball.js",
    "check:workflow-governance": "node scripts/check-workflow-governance.js",
    "setup:sqlite": "node scripts/setup-sqlite.js",
    "bench:verify": "node benchmarks/verifBench.js",
    "demo:knowledge-graph": "node scripts/knowledge-graph-demo.js --demo",
    "train": "node scripts/knowledge-graph-demo.js --demo",
    "test": "node scripts/run-tests.js --test-concurrency=4",
    "test:serial": "node scripts/run-tests.js --test-concurrency=1",
    "test:property": "node scripts/run-tests.js \"test/property/*.test.js\"",
    "test:watch": "node scripts/run-tests.js --watch",
    "test:graph": "node scripts/run-tests.js graph.test.js",
    "test:kernel": "node scripts/run-tests.js kernel.test.js",
    "test:cli": "node scripts/run-tests.js cli.test.js",
    "test:dream": "node scripts/run-tests.js dream.test.js",
    "test:plugin": "node scripts/run-tests.js plugin.test.js",
    "test:backup": "node scripts/run-tests.js backupRestore.test.js",
    "test:rust": "node scripts/run-tests.js rustGraph.test.js",
    "test:server": "node scripts/run-tests.js server.test.js",
    "conformance:external": "node scripts/external-conformance/run.js",
    "conformance:a2a": "node scripts/a2a-conformance/run.js",
    "check:v5-identity": "node scripts/check-v5-identity-readiness.js",
    "check:deterministic-path": "node scripts/check-deterministic-path.js"
  },
  "keywords": [
    "ai-governance",
    "agent-safety",
    "llm-verification",
    "trust-receipts",
    "provenance",
    "audit-trail",
    "approval-workflow",
    "mcp-server",
    "local-first",
    "deterministic-ai",
    "knowledge-graph",
    "contradiction-detection",
    "graph-reasoning",
    "explainable-ai",
    "symbolic-ai",
    "neuro-symbolic"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ali-ulu/huqan.git"
  },
  "bugs": {
    "url": "https://github.com/ali-ulu/huqan/issues"
  },
  "homepage": "https://github.com/ali-ulu/huqan#readme",
  "author": "Huqan Contributors",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.13.0"
  },
  "files": ["NOTICE"]
}
