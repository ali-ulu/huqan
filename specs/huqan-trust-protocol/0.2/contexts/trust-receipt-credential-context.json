{
  "@context": {
    "@protected": true,
    "@version": 1.1,
    "huqan": "https://huqan.dev/specs/huqan-trust-protocol/0.2/vocab#",
    "HuqanTrustCredential": {
      "@context": {
        "@protected": true,
        "bundleHash": "huqan:bundleHash",
        "createdAt": "huqan:createdAt",
        "decision": "huqan:decision",
        "receiptKind": "huqan:receiptKind",
        "riskScore": "huqan:riskScore",
        "status": "huqan:status",
        "trustPolicyVersion": "huqan:trustPolicyVersion",
        "verdict": "huqan:verdict"
      },
      "@id": "huqan:HuqanTrustCredential"
    },
    "HuqanPublicReceipt": {
      "@context": {
        "@protected": true,
        "publicReceipt": {
          "@id": "huqan:publicReceipt",
          "@type": "@json"
        }
      },
      "@id": "huqan:HuqanPublicReceipt"
    },
    "HuqanEd25519Signature2020": {
      "@context": {
        "@protected": true,
        "created": "huqan:proofCreated",
        "cryptosuite": "huqan:cryptosuite",
        "note": "huqan:proofNote",
        "proofPurpose": "huqan:proofPurpose",
        "proofValue": "huqan:proofValue",
        "signedProjection": "huqan:signedProjection",
        "verificationMethod": "huqan:verificationMethod"
      },
      "@id": "huqan:HuqanEd25519Signature2020"
    }
  }
}
