{
  "hooks": {
    "PostToolUse": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "huqan-gate browser-outcome --profile claude-code", "timeout": 30 }] }
    ],
    "PostToolUseFailure": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "huqan-gate browser-outcome --profile claude-code", "timeout": 30 }] }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "huqan-gate --profile claude-code",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
