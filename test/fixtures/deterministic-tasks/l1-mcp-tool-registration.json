{
  "id": "l1-mcp-tool-registration",
  "level": "L1",
  "description": "Register one MCP tool beside the existing deterministic tool list.",
  "operation": {
    "type": "insert_after",
    "path": "mcp/tools.js",
    "anchor": "  { name: 'axiom.verify' },\n",
