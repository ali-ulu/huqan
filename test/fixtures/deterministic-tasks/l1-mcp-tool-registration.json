  "files": {
    "mcp/tools.js": "'use strict';\n\nmodule.exports = [\n  { name: 'axiom.ask' },\n  { name: 'axiom.verify' },\n];\n"
  },
  "expectedPatch": [
    {
      "path": "mcp/tools.js",
      "before": "'use strict';\n\nmodule.exports = [\n  { name: 'axiom.ask' },\n  { name: 'axiom.verify' },\n];\n",
      "after": "'use strict';\n\nmodule.exports = [\n  { name: 'axiom.ask' },\n  { name: 'axiom.verify' },\n  { name: 'axiom.trace' },\n];\n"
    }
  ]
}
