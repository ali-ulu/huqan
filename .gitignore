node_modules/
graphify-out/
memory.json
memory.db
.route-server-*.db
memory.embeddings.json
memory.mutations.json
# Runtime lock for the JSON mutation journal (lib/mutation-journal-lock.js).
# Never commit one: a stale lock file in a fresh clone blocks the journal.
memory.mutations.json.lock
*.mutations.json.lock
# Crash/interrupted-write artifacts left behind by graph.js's
# atomicWriteFileSync (writes to a sibling `<file>.tmp-<pid>-<random>` before
# renaming into place). 40 of these previously slipped into git via #655.
*.tmp-[0-9]*-*
agent.memory.json
*.agent.json
memory.db-shm
memory.db-wal
test_memory.db
# Fixture databases the tests write beside themselves. The tests clean up after
# themselves; this is the backstop for a run that dies before its cleanup.
test/test-demo-seed.*
# Trust Receipts written at runtime, and by the smoke tests that exercise the
# receipt paths — generated output, not source.
receipts/
*.log
.env
# Local developer scratch files — use these prefixes for personal test output
local-*.json
local-*.js
backups/
obsidian-plugin/dist/
